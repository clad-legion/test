<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PreBana Cosmetics - Final Receipt</title>
    <link rel="stylesheet" href="/css/shck2.css">
    <style>
        @page {
            size: 80mm auto;
            margin: 3mm;
        }

        @media print {
            html,
            body {
                display: block !important;
                width: 74mm !important;
                min-width: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                color: #000 !important;
            }

            .chck2.final-receipt {
                width: 100% !important;
                max-width: none !important;
                min-height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                border: 0 !important;
                border-radius: 0 !important;
                box-shadow: none !important;
            }

            .tpdt {
                display: block !important;
                margin: 0 0 3mm !important;
                padding: 0 0 2mm !important;
                border-bottom: 1px dashed #000 !important;
            }

            .logo {
                justify-content: center !important;
            }

            .logo img {
                display: block !important;
                width: 12mm !important;
                height: 12mm !important;
                object-fit: contain !important;
            }

            .logo h2,
            .logo h2 span,
            .invoice-title h1,
            .invoice-title p,
            .slinfo h4,
            .info-item span,
            .info-item p,
            th,
            td,
            .order-meta,
            .total-row {
                color: #000 !important;
            }

            .logo h2 {
                font-size: 15pt !important;
                text-align: center;
            }

            .logo h2 span {
                display: inline !important;
                margin-left: 2mm;
                font-size: 9pt !important;
                letter-spacing: 0 !important;
            }

            .invoice-title {
                margin-top: 2mm;
                text-align: center !important;
            }

            .invoice-title h1 {
                font-size: 16pt !important;
            }

            .details-row {
                display: block !important;
                margin: 0 0 3mm !important;
            }

            .slinfo {
                width: 100% !important;
                margin: 0 !important;
                padding: 2mm 0 !important;
                border: 0 !important;
                border-bottom: 1px dashed #000 !important;
                border-radius: 0 !important;
                background: #fff !important;
            }

            .slinfo h4 {
                margin-bottom: 1mm !important;
                font-size: 8pt !important;
            }

            .info-item {
                margin-bottom: 1mm !important;
                gap: 2mm !important;
                font-size: 8pt !important;
            }

            .info-item p {
                overflow-wrap: anywhere;
            }

            table {
                width: 100% !important;
                table-layout: fixed;
                margin-bottom: 2mm !important;
                font-size: 7pt !important;
            }

            th,
            tbody td {
                padding: 1.5mm 1mm !important;
                overflow-wrap: anywhere;
                font-size: 7pt !important;
            }

            th:nth-child(1),
            td:nth-child(1) { width: 36%; }
            th:nth-child(2),
            td:nth-child(2) { width: 25%; }
            th:nth-child(3),
            td:nth-child(3) { width: 12%; }
            th:nth-child(4),
            td:nth-child(4) { width: 27%; }

            .summary-section {
                display: block !important;
                margin-top: 2mm !important;
            }

            .receipt-delivery {
                margin-top: 3mm;
                padding: 2mm 0 0;
                border-top: 1px dashed #000;
                font-size: 8pt;
                text-align: center;
            }

            .receipt-delivery h4,
            .receipt-delivery p {
                margin: 1mm 0;
            }

            .order-meta {
                margin-bottom: 2mm;
                padding: 2mm !important;
                border: 1px dashed #000 !important;
                background: #fff !important;
                font-size: 8pt !important;
            }

            .totals-box {
                width: 100% !important;
            }

            .total-row {
                padding: 1mm 0 !important;
                font-size: 8pt !important;
            }

            .total-row.grand-total {
                border-top: 1px dashed #000 !important;
                font-size: 10pt !important;
            }

            .actions {
                display: none !important;
            }

            tr,
            .slinfo,
            .summary-section {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="chck2 final-receipt">
        <div class="chckForm">
            <div class="tpdt">
                <div class="logo">
                    <img src="/uploads/f9defe2877af00458a37ce29ee922df7~tplv-tiktokx-cropcenter_1080_1080.jpeg" alt="PreBana Cosmetics logo">
                    <h2>PreBana<span>Cosmetics</span></h2>
                </div>
                <div class="invoice-title">
                    <h1>RECEIPT</h1>
                    <p id="receiptDate">Date: -</p>
                </div>
            </div>

            <div class="details-row">
                <div class="slinfo">
                    <h4>Paid By</h4>
                    <div class="info-item"><span>Name:</span><p id="payerName">-</p></div>
                    <div class="info-item"><span>Phone:</span><p id="payerPhone">-</p></div>
                    <div class="info-item"><span>Location:</span><p id="payerLocation">-</p></div>
                </div>
                <div class="slinfo">
                    <h4>Payment Details</h4>
                    <div class="info-item"><span>M-Pesa code:</span><p id="mpesaCode">-</p></div>
                    <div class="info-item"><span>Paid by:</span><p id="paymentPayerName">-</p></div>
                    <div class="info-item"><span>Phone:</span><p id="paymentPhone">-</p></div>
                    <div class="info-item"><span id="amountPaidLabel">Amount paid:</span><p id="amountPaid">-</p></div>
                    <div class="info-item"><span>Status:</span><p id="receiptStatus">Paid</p></div>
                </div>
            </div>

            <div class="cldt">
                <table>
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Product ID</th>
                            <th>Quantity</th>
                            <th>Price (Ksh)</th>
                        </tr>
                    </thead>
                    <tbody id="receiptItems"></tbody>
                </table>

                <div class="summary-section">
                    <div class="order-meta">
                        <p><strong>Total Products:</strong> <span id="totalProducts">0</span></p>
                        <p><strong>Total Quantity:</strong> <span id="totalQuantity">0</span></p>
                    </div>
                    <div class="totals-box">
                        <div class="total-row"><span>Product Cost:</span><span id="productCost">Ksh 0.00</span></div>
                        <div class="total-row"><span>Shipping Fees:</span><span id="shippingFees">Ksh 0.00</span></div>
                        <div class="total-row grand-total"><span id="orderTotalLabel">Total Paid:</span><span id="orderTotal">Ksh 0.00</span></div>
                    </div>
                </div>
                <div class="receipt-delivery">
                    <h4>Delivery details</h4>
                    <p>Location: <span id="deliveryLocation">-</span></p>
                    <p>Phone: <span id="deliveryPhone">-</span></p>
                </div>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="btn-cancel" onclick="window.location.href='/preBana/store'">Back to shop</button>
            <button type="button" class="btn-pay" id="downloadReceipt">Download receipt PDF</button>
            <button type="button" class="btn-pay" onclick="window.print()">Print receipt</button>
        </div>
    </div>

    <script>
        const receipt = JSON.parse(sessionStorage.getItem('prebanaFinalReceipt') || 'null');
        const order = receipt && receipt.order ? receipt.order : null;

        if (!receipt || !order) {
            document.querySelector('.final-receipt').innerHTML =
                '<p style="padding:40px">Receipt details are unavailable. Please complete payment again.</p>';
        } else {
            const payerName = receipt.payerName || order.customerName || '-';
            const payerPhone = receipt.phone || order.customerPhone || '-';
            const paidDate = receipt.paidAt ? new Date(receipt.paidAt) : new Date();
            const amountPaid = Number(receipt.amount) || Number(order.total) || 0;
            const isPendingVerification = receipt.status === 'pending_verification';

            document.getElementById('payerName').textContent = payerName;
            document.getElementById('payerPhone').textContent = maskPhone(payerPhone);
            document.getElementById('payerLocation').textContent = order.customerLocation || '-';
            document.getElementById('deliveryLocation').textContent = order.customerLocation || '-';
            document.getElementById('deliveryPhone').textContent = maskPhone(order.customerPhone || '-');
            document.getElementById('mpesaCode').textContent = receipt.mpesaCode || '-';
            document.getElementById('paymentPayerName').textContent = payerName;
            document.getElementById('paymentPhone').textContent = maskPhone(payerPhone);
            document.getElementById('amountPaid').textContent = 'Ksh ' + amountPaid.toFixed(2);
            document.getElementById('receiptStatus').textContent =
                isPendingVerification ? 'Pending verification' : 'Paid';
            if (isPendingVerification) {
                document.getElementById('amountPaidLabel').textContent = 'Amount submitted:';
                document.getElementById('orderTotalLabel').textContent = 'Order total:';
            }
            document.getElementById('receiptDate').textContent =
                'Date: ' + (isNaN(paidDate.getTime()) ? '-' : paidDate.toLocaleString());

            const tbody = document.getElementById('receiptItems');
            let totalQuantity = 0;

            (order.products || []).forEach(function (product) {
                const quantity = Number(product.quantity) || 0;
                totalQuantity += quantity;
                const row = document.createElement('tr');
                row.innerHTML =
                    '<td>' + escapeHtml(product.name) + '</td>' +
                    '<td>' + escapeHtml(product.id) + '</td>' +
                    '<td>' + quantity + '</td>' +
                    '<td>' + (Number(product.price) * quantity).toFixed(2) + '</td>';
                tbody.appendChild(row);
            });

            const productCost = Number(order.productCost) ||
                (order.products || []).reduce(function (sum, product) {
                    return sum + (Number(product.price) * (Number(product.quantity) || 0));
                }, 0);
            const shippingFees = Number(order.shippingFees) || 0;
            const total = amountPaid || productCost + shippingFees;

            document.getElementById('totalProducts').textContent = (order.products || []).length;
            document.getElementById('totalQuantity').textContent = totalQuantity;
            document.getElementById('productCost').textContent = 'Ksh ' + productCost.toFixed(2);
            document.getElementById('shippingFees').textContent = 'Ksh ' + shippingFees.toFixed(2);
            document.getElementById('orderTotal').textContent = 'Ksh ' + total.toFixed(2);
        }

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, function (character) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[character];
            });
        }

        function maskPhone(value) {
            const phone = String(value || '');
            if (phone.length < 7) return phone || '-';
            return phone.slice(0, 3) + '*'.repeat(phone.length - 6) + phone.slice(-3);
        }

        function normalizePdfText(value) {
            return String(value || '')
                .normalize('NFKD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^\x20-\x7E]/g, '?');
        }

        function escapePdfText(value) {
            return normalizePdfText(value).replace(/[\\()]/g, '\\$&');
        }

        function wrapPdfLine(value, maxLength) {
            const words = normalizePdfText(value).split(/\s+/);
            const wrapped = [];
            let line = '';

            words.forEach(function (word) {
                while (word.length > maxLength) {
                    if (line) {
                        wrapped.push(line);
                        line = '';
                    }
                    wrapped.push(word.slice(0, maxLength));
                    word = word.slice(maxLength);
                }

                if (!word) return;
                if (line && (line.length + word.length + 1) > maxLength) {
                    wrapped.push(line);
                    line = word;
                } else {
                    line = line ? line + ' ' + word : word;
                }
            });

            if (line) wrapped.push(line);
            return wrapped;
        }

        function downloadReceiptPdf() {
            const pendingVerification = receipt.status === 'pending_verification';
            const pdfProductCost = Number(order.productCost) ||
                (order.products || []).reduce(function (sum, product) {
                    return sum + (Number(product.price) * (Number(product.quantity) || 0));
                }, 0);
            const pdfShippingFees = Number(order.shippingFees) || 0;
            const pdfAmount = Number(receipt.amount) || Number(order.total) || 0;
            const lines = [
                'PreBana Cosmetics',
                'RECEIPT',
                'Date: ' + (document.getElementById('receiptDate').textContent.replace(/^Date:\s*/, '') || '-'),
                '------------------------------------------',
                'Payer: ' + (receipt.payerName || order.customerName || '-'),
                'Payment phone: ' + maskPhone(receipt.phone || order.customerPhone),
                'M-Pesa code: ' + (receipt.mpesaCode || '-'),
                'Status: ' + (pendingVerification ? 'Pending verification' : 'Paid'),
                '------------------------------------------',
                'ITEMS'
            ];

            (order.products || []).forEach(function (product) {
                const quantity = Number(product.quantity) || 0;
                lines.push(
                    (product.name || 'Product') + ' x' + quantity +
                    ' - Ksh ' + (Number(product.price) * quantity).toFixed(2)
                );
            });

            lines.push(
                '------------------------------------------',
                'Product cost: Ksh ' + pdfProductCost.toFixed(2),
                'Shipping: Ksh ' + pdfShippingFees.toFixed(2),
                (pendingVerification ? 'Order total: ' : 'Amount paid: ') + 'Ksh ' + pdfAmount.toFixed(2),
                '------------------------------------------',
                'DELIVERY',
                'Location: ' + (order.customerLocation || '-'),
                'Phone: ' + maskPhone(order.customerPhone || '-')
            );

            const wrappedLines = lines.reduce(function (all, line) {
                return all.concat(wrapPdfLine(line, 40));
            }, []);
            const pageWidth = 226.77;
            const pageHeight = Math.max(300, wrappedLines.length * 12 + 40);
            let y = pageHeight - 22;
            const commands = ['BT', '/F1 9 Tf'];

            wrappedLines.forEach(function (line, index) {
                if (index === 0) commands.push('/F1 12 Tf');
                else if (index === 1) commands.push('/F1 10 Tf');
                else if (index === 2) commands.push('/F1 8 Tf');
                else if (index === 3) commands.push('/F1 7 Tf');
                else if (index === 4) commands.push('/F1 9 Tf');

                commands.push('1 0 0 1 12 ' + y + ' Tm (' + escapePdfText(line) + ') Tj');
                y -= 12;
            });
            commands.push('ET');

            const content = commands.join('\n');
            const objects = [
                '<< /Type /Catalog /Pages 2 0 R >>',
                '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
                '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ' + pageWidth + ' ' + pageHeight + '] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>',
                '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>',
                '<< /Length ' + content.length + ' >>\nstream\n' + content + '\nendstream'
            ];

            let pdf = '%PDF-1.4\n';
            const offsets = [0];
            objects.forEach(function (object, index) {
                offsets.push(pdf.length);
                pdf += (index + 1) + ' 0 obj\n' + object + '\nendobj\n';
            });

            const xrefOffset = pdf.length;
            pdf += 'xref\n0 ' + (objects.length + 1) + '\n0000000000 65535 f \n';
            offsets.slice(1).forEach(function (offset) {
                pdf += String(offset).padStart(10, '0') + ' 00000 n \n';
            });
            pdf += 'trailer\n<< /Size ' + (objects.length + 1) + ' /Root 1 0 R >>\nstartxref\n' + xrefOffset + '\n%%EOF';

            const blob = new Blob([pdf], { type: 'application/pdf' });
            const link = document.createElement('a');
            const receiptCode = (receipt.mpesaCode || 'receipt').replace(/[^a-z0-9-]/gi, '');
            link.href = URL.createObjectURL(blob);
            link.download = 'PreBana-' + receiptCode + '.pdf';
            link.click();
            window.setTimeout(function () {
                URL.revokeObjectURL(link.href);
            }, 1000);
        }

        const downloadButton = document.getElementById('downloadReceipt');
        if (downloadButton && receipt && order) {
            downloadButton.addEventListener('click', downloadReceiptPdf);
        }
    </script>
</body>
</html>