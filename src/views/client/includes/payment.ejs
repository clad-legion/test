<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PreBana || Payment</title>
    <link rel="stylesheet" href="/css/shck2.css">
</head>
<body>
    <div class="paymentData">
        <div class="logo">
            <img src="/uploads/f9defe2877af00458a37ce29ee922df7~tplv-tiktokx-cropcenter_1080_1080.jpeg" alt="PreBana Cosmetics logo">
            <h2>PreBana<span>Cosmetics</span></h2>
        </div>

        <div class="payment-order">
            <h3>Order Summary</h3>
            <p><strong>Customer:</strong> <span id="customerName">-</span></p>
            <p><strong>Phone:</strong> <span id="customerPhone">-</span></p>
            <p><strong>Location:</strong> <span id="customerLocation">-</span></p>
        </div>

        <label for="pym">Method of payment:</label>
        <div class="ty" id="pym">
            Mpesa: <input type="radio" name="paymentMethod" value="mpesa" checked>
            Equity: <input type="radio" name="paymentMethod" value="equity" disabled>
        </div>

        <div class="paycard">
            <label for="payerName">Payer name:</label>
            <input type="text" name="payerName" id="payerName" maxlength="80" autocomplete="name" required>
            <label for="cph">Phone Number: </label>
            <input type="tel" name="phoneNumber" id="cph" placeholder="07XXXXXXXX">
            <label for="amount">Amount:</label>
            <input type="text" id="amount" disabled>
            <button type="button" id="payButton">Pay</button>
        </div>

        <div class="awaitpay" id="awaitpay" hidden>
            <h3>Searching For Payment</h3>
            <p id="paymentStatus">STK push has been sent.</p>
            <p>Please check your phone and confirm payment by entering your M-Pesa PIN.</p>
            <button type="button" id="cancelTransaction">Hide Status</button>
            <section id="manualCodeSection" hidden>
                <h3>Enter your M-Pesa confirmation code</h3>
                <p>Use this if automatic confirmation fails. Your order will remain pending until the payment is verified.</p>
                <label for="manualMpesaCode">M-Pesa code</label>
                <input type="text" id="manualMpesaCode" maxlength="20" autocomplete="off" placeholder="e.g. QGH7ABC123" required>
                <button type="button" id="submitManualCode">Submit code for verification</button>
                <p id="manualCodeFeedback" role="status" aria-live="polite"></p>
            </section>
        </div>

        <div class="recipt" id="paymentReceipt" hidden>
            <h3>Payment successful</h3>
            <p><strong>Payer:</strong> <span id="receiptPayer">-</span></p>
            <p><strong>Phone:</strong> <span id="receiptPhone">-</span></p>
            <p><strong>M-Pesa code:</strong> <span id="receiptMpesaCode">-</span></p>
            <button type="button" id="viewReceipt">View final receipt</button>
        </div>
    </div>

    <script>
        const savedOrder = JSON.parse(sessionStorage.getItem('prebanaOrder') || 'null');

        if (savedOrder) {
            document.getElementById('customerName').textContent = savedOrder.customerName;
            document.getElementById('customerPhone').textContent = savedOrder.customerPhone;
            document.getElementById('customerLocation').textContent = savedOrder.customerLocation;
            document.getElementById('payerName').value = savedOrder.customerName || '';
            document.getElementById('cph').value = savedOrder.customerPhone;

            const productCost = savedOrder.products.reduce(function (sum, product) {
                return sum + (Number(product.price) * Number(product.quantity));
            }, 0);
            const shippingFees = Number(savedOrder.shippingFees) || 0;
            const calculatedTotal = productCost + shippingFees;

            document.getElementById('amount').value = 'Ksh ' + calculatedTotal.toFixed(2);
            savedOrder.total = calculatedTotal;
            savedOrder.productCost = productCost;
        }

        let paymentPoll = null;
        let manualCodeTimer = null;
        let receiptRedirectScheduled = false;
        const checkoutStorageKey = 'prebanaCheckoutRequestId';

        function showManualCodeSection() {
            document.getElementById('manualCodeSection').hidden = false;
        }

        function startPaymentPolling(checkoutRequestId) {
            document.getElementById('awaitpay').hidden = false;
            document.getElementById('payButton').disabled = true;
            if (paymentPoll) clearInterval(paymentPoll);
            if (manualCodeTimer) clearTimeout(manualCodeTimer);
            manualCodeTimer = setTimeout(showManualCodeSection, 60000);
            paymentPoll = setInterval(function () {
                checkPaymentStatus(checkoutRequestId);
            }, 3000);
            checkPaymentStatus(checkoutRequestId);
        }

        async function checkPaymentStatus(checkoutRequestId) {
            try {
                const response = await fetch('/preBana/payment/status/' + encodeURIComponent(checkoutRequestId));
                if (!response.ok) {
                    document.getElementById('paymentStatus').textContent =
                        'Could not check payment status (HTTP ' + response.status + '). Retrying...';
                    return;
                }
                const status = await response.json();
                document.getElementById('paymentStatus').textContent =
                    status.status === 'completed'
                        ? 'Payment successful. M-Pesa receipt: ' + (status.mpesaReceiptNumber || '-')
                        : status.status === 'failed'
                            ? 'Payment failed: ' + (status.resultDescription || 'The transaction was not completed.')
                            : 'Waiting for phone confirmation...';

                if (status.status === 'completed' || status.status === 'failed') {
                    clearInterval(paymentPoll);
                    clearTimeout(manualCodeTimer);
                    sessionStorage.removeItem(checkoutStorageKey);
                    document.getElementById('payButton').disabled = status.status === 'completed';

                    if (status.status === 'failed') {
                        showManualCodeSection();
                    }

                    if (status.status === 'completed' && !receiptRedirectScheduled) {
                        receiptRedirectScheduled = true;
                        const payerName = document.getElementById('payerName').value.trim();
                        const receipt = {
                            payerName: payerName || (savedOrder ? savedOrder.customerName : ''),
                            phone: document.getElementById('cph').value.trim(),
                            mpesaCode: status.mpesaReceiptNumber || '',
                            checkoutRequestId: checkoutRequestId,
                            amount: status.amountPaid || status.amount || (savedOrder ? savedOrder.total : 0),
                            paidAt: status.transactionDate || new Date().toISOString(),
                            status: 'paid',
                            order: savedOrder
                        };
                        sessionStorage.setItem('prebanaFinalReceipt', JSON.stringify(receipt));
                        sessionStorage.removeItem('prebanaCart');

                        document.getElementById('receiptPayer').textContent = receipt.payerName || '-';
                        document.getElementById('receiptPhone').textContent = receipt.phone || '-';
                        document.getElementById('receiptMpesaCode').textContent = receipt.mpesaCode || '-';
                        document.getElementById('paymentReceipt').hidden = false;
                        window.setTimeout(function () {
                            window.location.href = '/preBana/finalrecipt';
                        }, 1200);
                    }
                }
            } catch (error) {
                document.getElementById('paymentStatus').textContent =
                    'Could not connect to check payment status. Retrying...';
            }
        }

        const pendingCheckoutRequestId = sessionStorage.getItem(checkoutStorageKey);
        if (pendingCheckoutRequestId) {
            document.getElementById('paymentStatus').textContent = 'Checking your previous payment...';
            startPaymentPolling(pendingCheckoutRequestId);
        }

        document.getElementById('payButton').addEventListener('click', async function () {
            const phone = document.getElementById('cph').value.trim();
            const payerName = document.getElementById('payerName').value.trim();
            if (payerName.length < 2) {
                alert('Enter the name of the person paying.');
                return;
            }
            if (!/^0\d{9}$/.test(phone)) {
                alert('Enter a valid Kenyan phone number starting with 0.');
                return;
            }
            if (!savedOrder) {
                alert('Your order details are missing. Please return to checkout.');
                return;
            }
            savedOrder.customerName = payerName;
            savedOrder.customerPhone = phone;
            sessionStorage.setItem('prebanaOrder', JSON.stringify(savedOrder));

            document.getElementById('awaitpay').hidden = false;
            document.getElementById('paymentStatus').textContent = 'Sending M-Pesa request...';
            document.getElementById('payButton').disabled = true;

            try {
                const response = await fetch('/preBana/payment/stk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        phone: phone,
                        products: savedOrder.products
                    })
                });
                const result = await response.json();
                if (!response.ok) {
                    if (result.checkoutRequestId) {
                        sessionStorage.setItem(checkoutStorageKey, result.checkoutRequestId);
                        document.getElementById('paymentStatus').textContent = result.error;
                        startPaymentPolling(result.checkoutRequestId);
                        return;
                    }
                    throw new Error(result.error || 'Could not initiate payment.');
                }

                sessionStorage.setItem(checkoutStorageKey, result.checkoutRequestId);
                document.getElementById('paymentStatus').textContent =
                    'STK push sent to ' + phone + ' for Ksh ' + result.amount.toFixed(2) + '.';
                startPaymentPolling(result.checkoutRequestId);
            } catch (error) {
                document.getElementById('paymentStatus').textContent = error.message;
                document.getElementById('payButton').disabled = false;
            }
        });

        document.getElementById('cancelTransaction').addEventListener('click', function () {
            document.getElementById('awaitpay').hidden = true;
        });

        document.getElementById('viewReceipt').addEventListener('click', function () {
            window.location.href = '/preBana/finalrecipt';
        });

        document.getElementById('submitManualCode').addEventListener('click', function () {
            const codeInput = document.getElementById('manualMpesaCode');
            const code = codeInput.value.trim().toUpperCase();
            const feedback = document.getElementById('manualCodeFeedback');
            if (!/^[A-Z0-9]{6,20}$/.test(code)) {
                feedback.textContent = 'Enter a valid M-Pesa code (6–20 letters or numbers).';
                codeInput.focus();
                return;
            }
            if (!savedOrder) {
                feedback.textContent = 'Order details are missing. Please return to checkout.';
                return;
            }

            const receipt = {
                payerName: document.getElementById('payerName').value.trim() || savedOrder.customerName || '',
                phone: document.getElementById('cph').value.trim() || savedOrder.customerPhone || '',
                mpesaCode: code,
                checkoutRequestId: sessionStorage.getItem(checkoutStorageKey) || '',
                amount: savedOrder.total || 0,
                paidAt: new Date().toISOString(),
                status: 'pending_verification',
                order: savedOrder
            };
            sessionStorage.setItem('prebanaFinalReceipt', JSON.stringify(receipt));
            feedback.textContent = 'Code submitted. Your receipt will show the order as pending verification.';
            window.setTimeout(function () {
                window.location.href = '/preBana/finalrecipt';
            }, 500);
        });
    </script>

</body>
</html>